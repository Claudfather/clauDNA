{
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(diff:*)",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git rev-parse:*)"
    ],
    "deny": [
      "Bash(gh gist:*)",
      "Bash(gh extension:*)",
      "Bash(gh alias:*)",
      "Bash(gh auth token:*)",
      "Bash(git config:*)",
      "Bash(git -c:*)"
    ]
  }
}
